<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon: "Accessibility settings". It can be dragged to the home screen as its own icon,
     for phones that keep switching the filter's service off. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="accessibility"
        android:enabled="true"
        android:icon="@drawable/ic_filter"
        android:shortcutShortLabel="@string/shortcut_short"
        android:shortcutLongLabel="@string/shortcut_long">
        <intent android:action="android.settings.ACCESSIBILITY_SETTINGS" />
    </shortcut>
</shortcuts>
